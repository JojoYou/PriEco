{{#if all_results}}
  <div class="div_output">
    <div data-sxpr-top-bar></div>
    <div class="results">
     {{#if did_you_mean}}
            <p class="spell_check">
            Did you mean
            <b><i>
                <a href="/search?t={{ type }}&q={{ did_you_mean }}">
                    {{ did_you_mean }}
                </a>
              </i></b>?
            </p>
       {{/if}}

      {{#each results}}
        <div class='output'>
            <div class="output_text">
              <div class="output_url">
                <img loading='lazy' alt="‎" src='{{ favicon }}'>
                <a href='{{ url }}' rel='noopener noreferrer' {{{ @root.newtab }}} class="link">
                <b>{{ domain }}</b>
                <p>{{ display_url }}</p>
                </a>
<div class="res_opt" tabindex="0" role="button">
  <img src="static/img/icon/dots.svg" alt="Options">
</div>

<div class="res_opt_menu">
  <div class="res_opt_header">
      <img loading="lazy" src="{{ favicon }}" alt="Favicon">
      <span class="res_opt_domain"><b>{{ domain }} - {{ title }}</b></span>
  </div>

<b>Actions</b>
  <div class="res_opt_actions">
    {{#if html_id}}
      <a href="/archive/{{html_id}}" target="_blank" title="Cached View">
        <img src="static/img/icon/cache.svg" alt="Cache">
        <p>Cache</p>
      </a>
    {{/if}}
    <a href="https://web.archive.org/web/*/{{url}}" target="_blank" title="Wayback Machine">
      <img src="static/img/icon/archive.svg" alt="Archive">
      <p>Internet Archive</p>
    </a>
  </div>

<b>Metrics</b>
  <div class="res_opt_insights">
    <span title="Load Speed">{{ formatted_load }}</span>
    <span title="Reading Complexity">{{ reading_level }}</span>
    <span title="Page Intent">{{ intent }}</span>
    <span title="Served from index">{{ source_engine }}</span>
  </div>

<b>Content</b>
<p class="res_opt_context">{{{ content }}}</p>
</div>
<div class="menu_backdrop res_opt_backdrop"></div>
              </div>
              <a href='{{ url }}' rel='noopener noreferrer' {{{ @root.newtab }}} class="link" data-sxpr-link>
                <h3>{{ title }}</h3>
              </a>
              <p>{{{ description }}}</p>
            </div>

            {{#if (eq ../css_path "static/css/desktop/")}}
              {{{ image }}}
            {{/if}}
        </div>

        {{#if @first}}
          <div class="knowledge_panel" data-sxpr-knowledge-panel>
          </div>
          <div data-sxpr-instant-answers></div>
        {{/if}}

        {{#if (and (eq @index 2) ../yadore)}}
          <div class="products">
            <p>👕 Products</p>
            <img src="static/img/icon/ad.svg" alt="products are sponsored">
          </div>
          <div class="yadore">
            {{#each ../yadore}}
              <div class="yadore_item">
                <a href="{{ url }}">
                  <button>
                    {{{ image }}}
                  </button>
                  <div class="yadore_text">
                    <p class="yadore_title">{{ title }}</p>
                    <p class="yadore_price">{{ price }}</p>
                    <div class="yadore_domain">
                      <img src="proxy?u={{ favicon }}" alt="‎" loading="lazy">
                      <p>{{ domain }}</p>
                    </div>
                  </div>
                </a>
              </div>
            {{/each}}
          </div>
        {{/if}}

        {{#if (and (eq @index 5) ../news)}}
          <div class="products">
            <p>📰 News</p>
          </div>
          <div class="yadore">
            {{#each ../news}}
              <div class="yadore_item">
                <a href="{{ url }}" rel='noopener noreferrer' {{{ @root.newtab }}}>
                  <button>
                    {{#if image}}
                      <img src="proxy?u={{ image }}" alt="News Thumbnail" loading="lazy" class="news_img">
                    {{else}}
                      <img alt="No image" loading="lazy">
                    {{/if}}
                  </button>
                  <div class="yadore_text">
                    <p class="news_text">{{ description }}</p>
                  </div>
                </a>
              </div>
            {{/each}}
          </div>
        {{/if}}

      {{/each}}
    </div>
  </div>
{{/if}}

{{#if img_results}}
  <div class="div_images">
    {{#each images}}
      <div class="div_single_img">
        <div tabindex="0" class="div_img_thumb">
          <img src="{{ thumbnail }}" alt="‎" class="thumb" loading="lazy">
          <a href="{{ site_url }}" rel='noopener noreferrer' {{{ @root.newtab }}} class="img_link">
            <img src="/proxy?u={{ favicon }}" alt="‎" loading="lazy">
            <p>{{ site_domain }}</p>
          </a>
        </div>

        <div class="div_full_img">
          <img src="{{ thumbnail }}" data-src="{{ image }}" alt="‎" loading="lazy">
          <br>
          <h3>{{ title }}</h3><br>
          <p>From website: {{ site_domain }}</p>
          <br>
          <div class="div_full_img_btn">
            <a href="{{ site_url }}" rel='noopener noreferrer' {{{ @root.newtab }}}>
              <button>Go to website</button>
            </a>
            <br>
            <a href="{{ image }}" rel='noopener noreferrer' {{{ @root.newtab }}}>
              <button>Go to image</button>
            </a>
          </div>
          <button>Close</button>
          </div>
      </div>
    {{/each}}
  </div>
{{/if}}

  {{#if new_results}}
  <div class="div_output">
    <div class="results">
      {{#each news}}
        <div class='output'>
            <div class="news_res output_text">
              <div class="output_url">
                {{#if favicon}}
                  <img loading='lazy' alt="‎" src='{{ favicon }}'>
                {{/if}}
                <a href='{{ url }}' rel='noopener noreferrer' {{{ @root.newtab }}} class="link">
                  <b>{{ domain }}</b>
                </a>
              </div>
              <a href='{{ url }}' rel='noopener noreferrer' {{{ @root.newtab }}} class="link">
                <h3>{{ title }}</h3>
              </a>
              <p>{{{ description }}}</p>
            </div>
            {{#if image}}
              <img src="proxy?u={{ image }}" alt="News image" loading="lazy" class="news_img">
            {{/if}}
        </div>
      {{/each}}
    </div>
  </div>
{{/if}}

<div class="quick_tune" tabindex="0" role="button">
    <img src="static/img/icon/tuning.svg" alt="Quick Tune">
</div>

<div class="qt_menu">
    <p>YOU decide how PriEco ranks results just for you</p>
    <a href="/quick_tune/export" download="my_prieco.goggle" class="qt_download_btn"><img src="static/img/icon/download.svg" alt="Export Tune"></a>
    <a href="/goggles" target="_blank">You have {{@root.active_goggle_count}} active Goggles</a>

   <form action="/quick_tune_update" method="POST">
    <input type="hidden" name="return_url" value="/search?q={{@root.query_enc}}&t={{@root.type}}&lang={{@root.lang}}&loc={{@root.loc}}">
  {{#if @root.no_js}}
        <button type="submit" class="qt_submit_btn" style="margin-top: 15px;">Apply</button>
    {{/if}}
    <div class="qt_grid">
        {{#each qt_domains}}
        <div class="qt_item" data-domain="{{this.domain}}">
            <img class="qt_icon" src="/proxy?u=https://fav.prieco.net/icon?url={{this.domain}}&size=32">
            <div class="qt_content">
                <span class="qt_domain">{{this.domain}}</span>

                {{#if @root.no_js}}
                    <div class="qt_actions">
                        <label class="qt_radio_label" title="None">
                            <input type="radio" name="prefs[{{this.domain}}]" value="none" {{#unless this.is_boost}}{{#unless this.is_downrank}}{{#unless this.is_discard}}checked{{/unless}}{{/unless}}{{/unless}}>
                            <span class="qt-btn">➖</span>
                        </label>
                        <label class="qt_radio_label" title="Boost">
                            <input type="radio" name="prefs[{{this.domain}}]" value="boost" {{#if this.is_boost}}checked{{/if}}>
                            <span class="qt-btn boost">👍</span>
                        </label>
                        <label class="qt_radio_label" title="Downrank">
                            <input type="radio" name="prefs[{{this.domain}}]" value="downrank" {{#if this.is_downrank}}checked{{/if}}>
                            <span class="qt-btn downrank">👎</span>
                        </label>
                        <label class="qt_radio_label" title="Discard">
                            <input type="radio" name="prefs[{{this.domain}}]" value="discard" {{#if this.is_discard}}checked{{/if}}>
                            <span class="qt-btn discard">🚫</span>
                        </label>
                    </div>
                {{else}}
                    <div class="qt_actions">
    <button type="button" class="qt-btn {{#unless this.is_boost}}{{#unless this.is_downrank}}{{#unless this.is_discard}}active none{{/unless}}{{/unless}}{{/unless}}" data-action="none">➖</button>
    <button type="button" class="qt-btn {{#if this.is_boost}}active boost{{/if}}" data-action="boost">👍</button>
    <button type="button" class="qt-btn {{#if this.is_downrank}}active downrank{{/if}}" data-action="downrank">👎</button>
    <button type="button" class="qt-btn {{#if this.is_discard}}active discard{{/if}}" data-action="discard">🚫</button>
</div>
                {{/if}}
            </div>
        </div>
        {{/each}}
    </div>

    {{#if saved_qt_domains}}
    <details>
        <summary class="other_tuned" style="margin-top: 15px; cursor: pointer;"><b>Other Tuned Domains</b></summary>
        <div class="qt_grid" style="margin-top: 10px;">
            {{#each saved_qt_domains}}
            <div class="qt_item" data-domain="{{this.domain}}">
                <img class="qt_icon" src="/proxy?u=https://fav.prieco.net/icon?url={{this.domain}}&size=32">
                <div class="qt_content">
                    <span class="qt_domain">{{this.domain}}</span>

                    {{#if @root.no_js}}
                        <div class="qt_actions">
                            <label class="qt_radio_label" title="None">
                                <input type="radio" name="prefs[{{this.domain}}]" value="none" {{#unless this.is_boost}}{{#unless this.is_downrank}}{{#unless this.is_discard}}checked{{/unless}}{{/unless}}{{/unless}}>
                                <span class="qt-btn">➖</span>
                            </label>
                            <label class="qt_radio_label" title="Boost">
                                <input type="radio" name="prefs[{{this.domain}}]" value="boost" {{#if this.is_boost}}checked{{/if}}>
                                <span class="qt-btn boost">👍</span>
                            </label>
                            <label class="qt_radio_label" title="Downrank">
                                <input type="radio" name="prefs[{{this.domain}}]" value="downrank" {{#if this.is_downrank}}checked{{/if}}>
                                <span class="qt-btn downrank">👎</span>
                            </label>
                            <label class="qt_radio_label" title="Discard">
                                <input type="radio" name="prefs[{{this.domain}}]" value="discard" {{#if this.is_discard}}checked{{/if}}>
                                <span class="qt-btn discard">🚫</span>
                            </label>
                        </div>
                    {{else}}
                        <div class="qt_actions">
    <button type="button" class="qt-btn {{#unless this.is_boost}}{{#unless this.is_downrank}}{{#unless this.is_discard}}active none{{/unless}}{{/unless}}{{/unless}}" data-action="none">➖</button>
    <button type="button" class="qt-btn {{#if this.is_boost}}active boost{{/if}}" data-action="boost">👍</button>
    <button type="button" class="qt-btn {{#if this.is_downrank}}active downrank{{/if}}" data-action="downrank">👎</button>
    <button type="button" class="qt-btn {{#if this.is_discard}}active discard{{/if}}" data-action="discard">🚫</button>
</div>
                    {{/if}}
                </div>
            </div>
            {{/each}}
        </div>
    </details>
    {{/if}}
</form>
</div>
<div class="menu_backdrop qt_backdrop"></div>
