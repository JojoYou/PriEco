<link rel="stylesheet" href="{{ css_path }}search/search_bar.css?v={{ css_version }}">
<link rel="stylesheet" href="{{ css_theme }}search/search_bar.css?v={{ css_version }}">

<div class="div_search_bar">
  <a href="/"
    ><img src="static/img/prieco.webp" alt="PriEco logo" class="logo"
  /></a>

  <div class="div_search_type">
    <!-- Search bar -->
<form action="search" method="{{#if check_post}}POST{{else}}GET{{/if}}" class="search_bar">
  <button class="search_button">
    <img src="static/img/icon/search.webp" alt="Search button icon" width="13px" />
  </button>
  <input type="hidden" name="t" value="{{ type }}">

  <div class="search_input_wrapper">
    <div class="ghost_box search_box"></div>
    <input name="q" placeholder="PriEco" value="{{ query }}" class="search_box" id="search_box" data-sxpr-input autocomplete="off">
    <div class="suggestions_container" style="display: none;"></div>
  </div>

  {{#unless no_js}}
    <button type="button" aria-label="Clear query button" class="btn_del_query">
      <img src="static/img/icon/cross.svg" alt="Delete query button">
    </button>
  {{/unless}}
</form>

    <!-- Type bar -->
    <div class="type_btns">
      <form action="search" method="{{#if check_post}}POST{{else}}GET{{/if}}">
        <input type="hidden" name="t" value="all">
        <input type="hidden" name="q" value="{{query}}">
        <button class="{{all_active}}">
          <img src="static/img/icon/earth.svg" alt="web search button">
          <p>All</p>
        </button>
      </form>

      <form action="search">
        <input type="hidden" name="t" value="img">
        <input type="hidden" name="q" value="{{query}}">
        <button class="{{img_active}}">
          <img src="static/img/icon/image.svg" alt="image search button">
          <p>Images</p>
        </button>
      </form>

      {{#unless no_js}}
      <form action="search" method="{{#if check_post}}POST{{else}}GET{{/if}}">
        <input type="hidden" name="t" value="map">
        <input type="hidden" name="q" value="{{query}}">
        <button class="{{map_active}}">
          <img src="static/img/icon/map.svg" alt="map search button">
          <p>Maps</p>
        </button>
      </form>
      {{/unless}}

      <button class="btn_settings">
        <label for="open-settings" class="open-settings-btn">
          <img src="static/img/icon/gear.svg" alt="open settings" width="13px">
        </label>
      </button>
    </div>
  </div>

<div class="donate" tabindex="0" role="button">Donate</div>
<div class="donate_box">
    <h2>Your donations grow<br>PriEco! 💚</h2>

    <input type="radio" name="donate-type" id="money" checked hidden>
    <input type="radio" name="donate-type" id="crypto" hidden>

    <div class="menu">
        <label for="money" class="btn">💳 Money</label>
        <label for="crypto" class="btn">₿ Crypto</label>
    </div>

    <div class="slider">

        <div class="panel money_panel">
            <a class="option" href="https://paypal.me/JojoYou" target="_blank">PayPal</a>
            <a class="option" href="https://buy.polar.sh/polar_cl_WFWzUsbGbOQELSX5NPxtJU1T6LH7latyEynAO2qUETR" target="_blank">Card one-time donation</a>
            <a class="option" href="https://buy.polar.sh/polar_cl_Wgv24IMNOThkkSs4FjyHe2ZTAsgy3QDAvkV8x1EYKkg" target="_blank">Card recurring donation</a>
        </div>

        <div class="panel crypto_panel">
            <div class="crypto_item">
                <span class="coin">Bitcoin</span>
                <input class="crypto_address" readonly value="bc1q9zs9n28jk4jx2w2659mhzd84skg0mlgkq7g3rr">
                {{#unless no_js}}
                    <button class="copy_btn" type="button" data-copy="bc1q9zs9n28jk4jx2w2659mhzd84skg0mlgkq7g3rr">Copy</button>
                {{/unless}}
            </div>

            <div class="crypto_item">
                <span class="coin">Ethereum</span>
                <input class="crypto_address" readonly value="0x61bF924B3E3Cf687D8FbE39d75daea9ACB204fE3">
                {{#unless no_js}}
                    <button class="copy_btn" type="button" data-copy="0x61bF924B3E3Cf687D8FbE39d75daea9ACB204fE3">Copy</button>
                {{/unless}}
            </div>

            <div class="crypto_item">
                <span class="coin">Solana</span>
                <input class="crypto_address" readonly value="DJS1CEu1atr46Tkyg5Vq2fZKqW11gj27TmfQ9VF2fZ6h">
                {{#unless no_js}}
                    <button class="copy_btn" type="button" data-copy="DJS1CEu1atr46Tkyg5Vq2fZKqW11gj27TmfQ9VF2fZ6h">Copy</button>
                {{/unless}}
            </div>

            <div class="crypto_item">
                <span class="coin">Monero</span>
                <input class="crypto_address" readonly value="43rNgiiG5PRGWaqDtKEuYmQrAGkXBEsJh5RXLagaQeMm9j7dGkAszjPS8T3XyBEviRGcBLFYFrZFyj8xByKVJ4PLSQtd8jE">
                {{#unless no_js}}
                    <button class="copy_btn" type="button" data-copy="43rNgiiG5PRGWaqDtKEuYmQrAGkXBEsJh5RXLagaQeMm9j7dGkAszjPS8T3XyBEviRGcBLFYFrZFyj8xByKVJ4PLSQtd8jE">Copy</button>
                {{/unless}}
            </div>

        </div>
    </div>
</div>
{{#unless no_js}}
<script src="static/js/donate.js?v={{ js_version }}"></script>
<script src="/static/js/tune.js?v={{ js_version }}"></script>
<script src="static/js/suggestions.js?v={{ js_version }}"></script>
{{/unless}}
</div>
