{{> header }}

  <link href="{{ css_path }}roadmap.css" rel="stylesheet" type="text/css">

  <div class="background"></div>

  <div class="container">
    <h1 class="title">Submission</h1>

<div class="response">
    <p>Send us URLs you'd like PriEco to index</p>
    <p>After submission it should take just a few minutes to add them to PriEco</p>
    <p>Please 1 URL a line</p>
    <form action="/submit" method="POST">
    <textarea id="message" name="message" rows="8" placeholder="Links line by line" required></textarea>
    <button type="submit">Send</button>
</form>
</div>

{{> footer }}
