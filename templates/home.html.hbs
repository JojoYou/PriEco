{{> header }}

<link rel="stylesheet" href="{{ css_path }}settings.css?v={{ css_version }}">
<link rel="stylesheet" href="{{ css_theme }}settings.css?v={{ css_version }}">
{{#if no_js}}
  {{> settings settings}}
{{else}}
  <div id="js_load_settings"></div>
{{/if}}

<link rel="stylesheet" href="{{ css_path }}home.css?v={{ css_version }}">
<link rel="stylesheet" href="{{ css_theme }}home.css?v={{ css_version }}">

<label for="open-settings" class="open-settings-btn">
   <img src="static/img/icon/gear.svg" alt="open settings" width="13px">
</label>

<div class="bg_search_bar">
  <div class="div_search_bar">
    <img src="static/img/prieco.webp" class="logo" alt="PriEco logo">
    <span class="title">PriEco</span>

    <form action="search" method="{{#if check_post}}POST{{else}}GET{{/if}}" class="search_bar">
      <input type="hidden" name="t" value="all">

      <button aria-label="search button" class="search_button">
        <img src="static/img/icon/search.webp" alt="Search button icon" width="13px">
      </button>

      <div class="search_input_wrapper">
        <div class="ghost_box search_box"></div>
        <input name="q" placeholder="Search" class="search_box" id="search_box" autocomplete="off" required>
        <div class="suggestions_container" style="display: none;"></div>
      </div>

      {{#unless no_js}}
        <button type="button" aria-label="Clear query button" class="btn_del_query">
          <img src="static/img/icon/cross.svg" alt="Delete query button">
        </button>
      {{/unless}}
    </form>

  </div>
</div>

{{#unless no_js}}
  <script src="static/js/del_query.js?v={{ js_version }}"></script>
  <script src="static/js/suggestions.js?v={{ js_version }}"></script>
{{/unless}}

{{> footer }}
