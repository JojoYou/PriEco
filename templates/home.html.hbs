{{> header }}

<link rel="stylesheet" href="{{ css_path }}settings.css?v={{ css_version }}">
<link rel="stylesheet" href="{{ css_theme }}settings.css?v={{ css_version }}">
{{#if no_js}}
  {{> settings settings}}
{{else}}
  <div id="js_load_settings"></div>
{{/if}}

<link rel="stylesheet" href="{{ css_path }}home.css?v={{ css_version }}">
<link rel="stylesheet" href="{{ css_theme }}home.css?v={{ css_version }}">

<label for="open-settings" class="open-settings-btn">
   <img src="static/img/icon/gear.svg" alt="open settings" width="13px">
</label>

<div class="bg_search_bar">
  <div class="div_search_bar">
    <img src="static/img/prieco.webp" class="logo" alt="PriEco logo">
    <span class="title">PriEco</span>

    <form action="search" method="{{#if check_post}}POST{{else}}GET{{/if}}" class="search_bar">
      <input type="hidden" name="t" value="all">

      <button aria-label="search button" class="search_button">
        <img src="static/img/icon/search.webp" alt="Search button icon" width="13px">
      </button>

      <div class="search_input_wrapper">
        <div class="ghost_box search_box"></div>
        <input name="q" placeholder="What are you looking for?" class="search_box" id="search_box" autocomplete="off" required>
        <div class="suggestions_container"></div>
      </div>

      {{#unless no_js}}
        <button type="button" aria-label="Clear query button" class="btn_del_query">
          <img src="static/img/icon/cross.svg" alt="Delete query button">
        </button>
      {{/unless}}
    </form>

<div class="shortcuts">
  {{#each shortcuts}}
    <div class="shortcut">
      <div>
        <div tabindex="0" class="shortcutEditBtn{{this.id}} shortcutEditBtn">•</div>

        <a href="{{this.url}}" class="shortcutBtn{{this.id}}">
          <div tabindex="0" class="shortcutElemenet">
            <img src="{{this.icon}}" alt="{{this.name}}">
          </div>
        </a>

        <div class="shortcutEditForm{{this.id}} shortcutEditForm shortcutForm">
          <form method="post" action="/">
            <input type="hidden" name="action" value="delete">
            <input type="hidden" name="shortcutID" value="{{this.id}}">
            <input type="submit" name="shortcutDelete" value="Delete" class="redBtn DelShortcut">
          </form>

          <p><b>Edit</b></p>
          <p>{{this.name}}</p>

          <form method="post" action="/">
            <input type="hidden" name="action" value="edit">
            <input type="hidden" name="shortcutID" value="{{this.id}}">
            <input type="text" name="shortcutName" placeholder="Name" value="{{this.name}}" required>
            <input type="text" name="shortcutURL" placeholder="URL" value="{{this.url}}" required>
            <input type="submit" name="shortcutEdit" class="Pointer" value="Edit">
          </form>
        </div>
          <p class="sh_txt">{{this.display_name}}</p>
      </div>
    </div>
  {{/each}}

  <div tabindex="0" id="addShortcutBtn" class="shortcutElemenet">+</div>
  <div class="addShortcut shortcutForm">
    <p><b>Add shortcut</b></p>
    <form method="POST" action="/">
      <input type="hidden" name="action" value="add">
      <input type="text" name="shortcutName" placeholder="Name" required>
      <input type="text" name="shortcutURL" placeholder="URL" required>
      <input type="submit" name="shortcutSubmit" value="Add" class="Pointer">
    </form>
  </div>
</div>
  </div>
</div>


<div class="info_section">
  <a href="#scroll" class="scroll_down">
    <img class="floatAnim" src="static/img/icon/arrow-down.webp" alt="Arrow down">
  </a>

  <div id="scroll" class="hey_section">
    <div class="hey_text">
      <h1>Hey 👋</h1>
      <ul>
        <li>PriEco is a general purpose web search. You can search whatever you want!</li>
        <li>We have own index, so we are independent in European Union but the results may not be as good yet.</li>
        <li>We never track nor profile you, we don't know you.</li>
        <li>PriEco runs on renewable energy.</li>
        <li>We don't have secrets, you can inspect how PriEco works <a href="https://codeberg.org/JojoYou/PriEco/" target="_blank" class="link">here</a>!</li>
      </ul>
    </div>
    <img class="floatAnim hey_img" src="static/img/people_on_mini_cloud_transparent.svg" alt="People on cloud">
  </div>

