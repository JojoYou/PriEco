<!-- Settings open btn -->
<input type="checkbox" id="open-settings" hidden>

<!-- Settings -->
<section class="settings">
<form action="/settings_update" method="POST">
  <div class="settings-header">
    <img src="static/img/icon/gear.svg" alt="Settings icon" width="17px">
    <p>Settings</p>
      <label for="open-settings">
        <img src="static/img/icon/cross.svg" alt="close settings" class="btn-close-settings">
      </label>
  </div>

  <div class="settings-content">
    <div class="settings-group" hidden>
      <h3>📊 Stats</h3>
      <div class="settings-item">
        <label for="check_index" title="Use pure PriEco index, no external results">🌲 PriEco:</label>
        <div class="checkbox_cute">
          <div class="check">
           <input id="check_index" type="checkbox">
            <label for="check_index"></label>
          </div>
        </div>
      </div>
      <br>
      <div class="settings-item">
        <input type="range" aria-label="PriEco user search statics" value="{{ prieco_user_stats }}" min="0" max="100" step="1" style="--fill-percent: {{ prieco_user_stats }}%;" class="user_index_stats" disabled>
        <div class="user_index_stats_label">{{ prieco_user_stats }} %</div>
      </div>
    </div>

  {{#if no_js}}
    <button type="submit" class="settings-save">Save</button>
  {{/if}}

    <div class="settings-group">
      <h3>General</h3>
      <br>
